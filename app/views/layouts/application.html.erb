<!DOCTYPE html>
<html lang="en">
  <head>
    <title>PropBet - Social Prediction Market</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= stylesheet_link_tag 'application', media: 'all' %>
    <%= javascript_include_tag 'application' %>
  </head>

  <body class="bg-dark text-light">
    <nav class="navbar">
      <div class="container nav-content">
        <a class="nav-brand" href="<%= root_path %>">PropBet</a>
        <div class="nav-links">
          <%= link_to "Markets", markets_path, class: "nav-link" %>
          <%= link_to "Pools", pools_path, class: "nav-link" %>
          <%= link_to "Leaderboard", leaderboard_path, class: "nav-link" %>
          <% if logged_in? %>
            <%= link_to "Wallet ($#{'%.2f' % current_user.balance})", wallet_path, class: "nav-link wallet-link" %>
            <%= link_to "Sign Out", session_path, data: { turbo_method: :delete }, class: "nav-link sign-out" %>
          <% else %>
            <%= link_to "Sign In", new_session_path, class: "nav-link btn-primary-sm" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container main-content">
      <% if flash[:notice] %>
        <div class="flash flash-success"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert] %>
        <div class="flash flash-danger"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>

    <footer class="footer">
      <div class="container">
        <p>PropBet &mdash; Social Prediction Market &bull; <em>Bet responsibly. Platform takes <%= "5" %>% house cut.</em></p>
      </div>
    </footer>
  </body>
</html>
