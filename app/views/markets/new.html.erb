<div style="max-width: 600px; margin: 0 auto;">
  <div class="page-header">
    <h1 class="page-title">Create Market</h1>
    <%= link_to "Cancel", markets_path, class: "btn btn-outline" %>
  </div>

  <div class="card">
    <%= form_with model: @market, url: markets_path, method: :post do |f| %>
      <div class="form-group">
        <label class="form-label">Market Question *</label>
        <%= f.text_field :title, class: "form-control", placeholder: 'e.g. "Will Sarah wear a blue shirt tomorrow?"', required: true %>
      </div>

      <div class="form-group">
        <label class="form-label">Subject (who is the bet about?)</label>
        <%= f.text_field :subject_name, class: "form-control", placeholder: "Person's name (optional)" %>
        <small style="color: var(--text-muted); font-size: 0.75rem; margin-top: 0.25rem; display: block;">
          If this person has opted out, the market cannot be created.
        </small>
      </div>

      <div class="form-group">
        <label class="form-label">Description / Context</label>
        <%= f.text_area :description, class: "form-control", placeholder: "Add context or evidence criteria..." %>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label">Market Type *</label>
          <%= f.select :market_type,
              [['Yes / No (Binary)', 'binary'], ['Multi-Choice', 'multi']],
              {},
              class: "form-control",
              id: "market_type_select" %>
        </div>

        <div class="form-group">
          <label class="form-label">House Cut (%)</label>
          <%= f.number_field :house_cut_pct, class: "form-control", min: 0, max: 20, step: 0.5, value: 5.0 %>
        </div>
      </div>

      <div class="form-group" id="multi_options_group" style="display: none;">
        <label class="form-label">Options (one per line)</label>
        <textarea name="options" class="form-control" style="min-height: 100px;" placeholder="Option 1&#10;Option 2&#10;Option 3"></textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label class="form-label">End Time *</label>
          <%= f.datetime_local_field :end_time, class: "form-control", min: Time.current.strftime('%Y-%m-%dT%H:%M'), required: true %>
        </div>

        <div class="form-group">
          <label class="form-label">Pool (optional)</label>
          <%= f.select :pool_id,
              [['No Pool (Public)', nil]] + @pools.map { |p| [p.name, p.id] },
              { include_blank: false },
              class: "form-control" %>
        </div>
      </div>

      <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border);">
        <%= f.submit "Create Market", class: "btn btn-primary", style: "font-size: 1rem; padding: 0.75rem 2rem;" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.getElementById('market_type_select').addEventListener('change', function() {
    var multiGroup = document.getElementById('multi_options_group');
    multiGroup.style.display = this.value === 'multi' ? 'block' : 'none';
  });
</script>
