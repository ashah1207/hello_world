<div style="max-width: 480px; margin: 0 auto;">
  <div class="page-header">
    <h1 class="page-title">Create Pool</h1>
    <%= link_to "Cancel", pools_path, class: "btn btn-outline" %>
  </div>

  <div class="card">
    <%= form_with model: @pool, url: pools_path, method: :post do |f| %>
      <div class="form-group">
        <label class="form-label">Pool Name *</label>
        <%= f.text_field :name, class: "form-control", placeholder: 'e.g. "College Friends", "Workplace Sharks"', required: true %>
      </div>

      <div class="form-group">
        <label class="form-label">Pool Type *</label>
        <%= f.select :pool_type,
            [['Public - Anyone can join', 'public'], ['Private - Invite code required', 'private']],
            {},
            class: "form-control" %>
      </div>

      <div style="background: rgba(255, 215, 0, 0.08); border: 1px solid rgba(255, 215, 0, 0.3); border-radius: 8px; padding: 0.75rem; margin-bottom: 1rem; font-size: 0.8rem; color: var(--text-muted);">
        Private pools get a randomly generated invite code you can share with friends.
      </div>

      <%= f.submit "Create Pool", class: "btn btn-primary", style: "width: 100%; font-size: 1rem; padding: 0.75rem;" %>
    <% end %>
  </div>
</div>
