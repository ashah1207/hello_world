<div class="page-header">
  <h1 class="page-title">My Wallet</h1>
</div>

<div class="stats-row">
  <div class="stat-box">
    <div class="stat-value">$<%= '%.2f' % @user.balance %></div>
    <div class="stat-label">Available Balance</div>
  </div>
  <div class="stat-box">
    <div class="stat-value" style="color: var(--accent-yellow);">$<%= '%.2f' % @user.active_bets_total %></div>
    <div class="stat-label">In Active Bets</div>
  </div>
  <div class="stat-box">
    <div class="stat-value" style="color: <%= @net_profit >= 0 ? 'var(--accent-green)' : 'var(--accent-red)' %>;">
      <%= @net_profit >= 0 ? '+' : '' %>$<%= '%.2f' % @net_profit.abs %>
    </div>
    <div class="stat-label">All-time Profit</div>
  </div>
  <div class="stat-box">
    <div class="stat-value" style="font-size: 1.2rem;"><%= @user.bets.count %></div>
    <div class="stat-label">Total Bets Placed</div>
  </div>
</div>

<div class="layout-split">
  <div>
    <%# Active Bets %>
    <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Active Bets (<%= @active_bets.count %>)</h3>
    <% if @active_bets.empty? %>
      <div class="card" style="text-align: center; padding: 2rem; margin-bottom: 1.5rem;">
        <p style="color: var(--text-muted);">No active bets. <%= link_to "Find a market!", markets_path, style: "color: var(--accent-green);" %></p>
      </div>
    <% else %>
      <div style="display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem;">
        <% @active_bets.each do |bet| %>
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
              <div>
                <%= link_to bet.market.title.truncate(60), market_path(bet.market), style: "color: var(--text-primary); font-weight: 600; text-decoration: none; font-size: 0.9rem;" %>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
                  Bet on: <strong style="color: var(--accent-green);"><%= bet.market_option.label %></strong>
                  &bull; Ends <%= time_ago_in_words(bet.market.end_time) %> <%= bet.market.end_time > Time.current ? "from now" : "ago" %>
                </div>
              </div>
              <div style="text-align: right;">
                <div style="font-weight: 700; color: var(--accent-yellow);">$<%= '%.2f' % bet.amount %></div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">
                  Potential: $<%= '%.2f' % (bet.amount * bet.market.payout_multiplier(bet.market_option)) %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Settled Bets History %>
    <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Bet History</h3>
    <% if @settled_bets.empty? %>
      <div class="card" style="text-align: center; padding: 2rem;">
        <p style="color: var(--text-muted);">No settled bets yet.</p>
      </div>
    <% else %>
      <div class="card" style="padding: 0; overflow: hidden;">
        <% @settled_bets.each do |bet| %>
          <div style="padding: 0.85rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
            <div>
              <%= link_to bet.market.title.truncate(50), market_path(bet.market), style: "color: var(--text-primary); text-decoration: none; font-size: 0.85rem; font-weight: 600;" %>
              <div style="font-size: 0.75rem; color: var(--text-muted);">
                <%= bet.market_option.label %> &bull; Wagered $<%= '%.2f' % bet.amount %>
              </div>
            </div>
            <div style="text-align: right; font-weight: 700; color: <%= bet.payout_amount.to_f > 0 ? 'var(--accent-green)' : 'var(--accent-red)' %>;">
              <%= bet.payout_amount.to_f > 0 ? "+$#{'%.2f' % bet.payout_amount}" : "Lost" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Right sidebar: Settings + Deposit %>
  <div>
    <div class="card" style="margin-bottom: 1rem;">
      <h3 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Deposit Funds</h3>
      <%= form_with url: wallet_deposit_path, method: :post do |f| %>
        <div class="form-group">
          <label class="form-label">Amount ($)</label>
          <%= number_field_tag :amount, nil, class: "form-control", min: 1, max: 10000, step: 0.01, placeholder: "e.g. 50.00" %>
        </div>
        <%= submit_tag "Add Funds", class: "btn btn-primary", style: "width: 100%;" %>
      <% end %>
    </div>

    <div class="card">
      <h3 style="font-size: 0.9rem; font-weight: 700; margin-bottom: 1rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Privacy &amp; Safety</h3>

      <div style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <strong style="font-size: 0.9rem;">Opt-Out (Blacklist)</strong>
          <span class="badge <%= @user.blacklisted? ? 'badge-open' : 'badge-resolved' %>">
            <%= @user.blacklisted? ? 'ON' : 'OFF' %>
          </span>
        </div>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem;">
          Prevent others from creating markets about you.
        </p>
        <%= button_to @user.blacklisted? ? "Disable Opt-Out" : "Enable Opt-Out",
            blacklist_path, method: :post,
            class: "btn #{@user.blacklisted? ? 'btn-outline' : 'btn-danger'}",
            style: "width: 100%; font-size: 0.85rem;" %>
      </div>

      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
          <strong style="font-size: 0.9rem;">Anonymous Mode</strong>
          <span class="badge <%= @user.anonymous_default? ? 'badge-open' : 'badge-resolved' %>">
            <%= @user.anonymous_default? ? 'ON' : 'OFF' %>
          </span>
        </div>
        <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.75rem;">
          Bet anonymously by default in all markets.
        </p>
        <%= button_to @user.anonymous_default? ? "Disable Anonymous" : "Enable Anonymous",
            toggle_anonymous_path, method: :post,
            class: "btn btn-outline",
            style: "width: 100%; font-size: 0.85rem;" %>
      </div>
    </div>
  </div>
</div>
